    <system:String x:Key="Str_Update_Title">Update verfügbar</system:String>
    <system:String x:Key="Str_Update_Apply">Aktualisieren</system:String>
    <system:String x:Key="Str_Update_Downloading">Wird heruntergeladen...</system:String>
