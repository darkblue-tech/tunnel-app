<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Client.Desktop.App"
             RequestedThemeVariant="Light">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DarkTunnel Client/ColorPalette.axaml" />
                <ResourceInclude Source="avares://DarkTunnel Client/Assets/i18n/en.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="RobotoFlexFont">avares://DarkTunnel Client/Assets/roboto_flex.ttf#Roboto Flex</FontFamily>
            <FontFamily x:Key="InterFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource RobotoFlexFont}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource BgPrimary}" />
        </Style>
        
        <!-- Clean ToggleButton without blue backgrounds -->
        <Style Selector="ToggleButton.CleanToggle">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Custom ComboBox Styles -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BgSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- ComboBox hover state -->
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource BgSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
        </Style>

        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="4,2" />
        </Style>

        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgPrimary}" />
        </Style>

        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource TextAccent}" />
        </Style>
    </Application.Styles>


</Application>


