<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Client.Desktop.ViewModels"
        xmlns:v="using:Client.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="800"
        Width="500" Height="800"
        x:Class="Client.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app.ico"
        Title="DarkTunnel Client"
        TransparencyLevelHint="Mica"
        Background="{DynamicResource BgPrimary}"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <v:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <v:MainView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatsViewModel}">
            <v:StatsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid>
        <!-- Main Router Content -->
        <TransitioningContentControl Content="{Binding CurrentViewModel}" />

        <!-- Update Notification Banner -->
        <Border Background="{DynamicResource BgSecondary}" 
                BorderBrush="{DynamicResource IconAccent}" 
                BorderThickness="2" 
                CornerRadius="14"
                VerticalAlignment="Top" 
                Margin="20,40,20,0"
                Padding="16,14"
                BoxShadow="0 8 24 0 #40000000"
                IsVisible="{Binding HasUpdateResult}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_Update_Title}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                        <Border Background="{DynamicResource BgPrimary}" CornerRadius="6" Padding="6,2">
                            <TextBlock Text="{Binding UpdateVersionText, StringFormat='v{0}'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource IconAccent}"/>
                        </Border>
                    </StackPanel>
                    
                    <Button Grid.Column="2" Command="{Binding DismissUpdateCommand}" 
                            IsEnabled="{Binding !IsUpdating}"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <Svg Path="avares://DarkTunnel Client/Assets/Icons/x.svg" Width="18" Height="18"/>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding UpdateNotesText}" 
                           FontSize="12" Foreground="{DynamicResource TextPrimary}" 
                           Opacity="0.8" TextWrapping="Wrap" Margin="0,8,0,12" MaxHeight="60" />

                <StackPanel Grid.Row="2" Margin="0,0,0,12" IsVisible="{Binding IsUpdating}">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="{Binding UpdateProgressText}" 
                                   FontSize="12" Foreground="{DynamicResource TextPrimary}" Opacity="0.8"/>
                        <TextBlock Grid.Column="1" Text="{Binding UpdateProgressPercentage, StringFormat='{}{0:0}%'}" 
                                   FontSize="12" FontWeight="Bold" Foreground="{DynamicResource IconAccent}"/>
                    </Grid>
                    <ProgressBar Value="{Binding UpdateProgressPercentage}" Minimum="0" Maximum="100" 
                                 Height="6" CornerRadius="3"
                                 Background="{DynamicResource BgPrimary}" 
                                 Foreground="{DynamicResource IconAccent}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Command="{Binding DismissUpdateCommand}" 
                            IsEnabled="{Binding !IsUpdating}"
                            Background="Transparent" BorderBrush="{DynamicResource Stroke}" 
                            BorderThickness="1" CornerRadius="6" Padding="12,6" Cursor="Hand">
                        <TextBlock Text="{DynamicResource Str_Update_Dismiss}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    </Button>

                    <Button Command="{Binding ApplyUpdateCommand}" 
                            IsEnabled="{Binding !IsUpdating}"
                            Background="{DynamicResource IconAccent}" 
                            BorderThickness="0" CornerRadius="6" Padding="14,6" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{DynamicResource Str_Update_Apply}" IsVisible="{Binding !IsUpdating}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="{DynamicResource Str_Update_Downloading}" IsVisible="{Binding IsUpdating}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Logs Overlay (Bottom Sheet) -->
        <Border Background="{DynamicResource BgSecondary}" 
                CornerRadius="16,16,0,0"
                VerticalAlignment="Bottom"
                Height="300"
                Margin="0,0,0,0"
                IsVisible="{Binding IsLogsPanelOpen}"
                BoxShadow="0 -4 10 0 #20000000">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,15,20,10">
                    <TextBlock Grid.Column="0" Text="Logs" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                    <Button Grid.Column="1" Command="{Binding ToggleLogsPanelCommand}" Background="Transparent" BorderThickness="0">
                        <Svg Path="avares://DarkTunnel Client/Assets/Icons/chevron-down.svg" Width="24" Height="24"/>
                    </Button>
                </Grid>
                
                <ScrollViewer Grid.Row="1" Margin="20,0,20,20">
                    <TextBox Text="{Binding GlobalLogs}" 
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="{StaticResource InterFont}" 
                             FontSize="12" FontWeight="Bold"
                             Foreground="{DynamicResource TextAccent}"
                             TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>


